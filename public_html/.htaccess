<IfModule mod_rewrite.c>
  DirectoryIndex index.html

  RewriteEngine On

  # Preserve bearer-token authentication for Laravel API requests.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Laravel's standard front controller. With document root set to
  # httpdocs/public, Nginx can forward /api without cross-directory rewrites.
  RewriteRule ^api(?:/.*)?$ index.php [END,QSA]

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React SPA fallback for every non-API route.
  RewriteRule . index.html [L]
</IfModule>
