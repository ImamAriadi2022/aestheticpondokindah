<IfModule mod_rewrite.c>
  RewriteEngine On

  # Preserve bearer-token authentication for Laravel API requests.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Laravel API front controller (Laravel lives one level above this webroot).
  RewriteRule ^api(?:/.*)?$ ../public/index.php [L,QSA]

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Promo pages: serve with dynamic OG meta tags
  RewriteRule ^promo(/.*)?$ /promo-meta.php [L]

  RewriteRule . /index.html [L]
</IfModule>
