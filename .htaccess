<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve bearer-token authentication for Laravel API requests.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve the Laravel API through a root front controller. Keeping the
    # target in httpdocs avoids Plesk rejecting an internal /public/index.php
    # rewrite with HTTP 400.
    RewriteRule ^api(?:/.*)?$ api.php [END,QSA]

    # Expose only Laravel's public uploads. The root storage/ directory is
    # private application data and remains blocked by the rule below.
    RewriteRule ^storage/(.*)$ public/storage/$1 [L,NC]

    # Protect application internals from direct web access.
    RewriteRule \.env$ - [F,L]
    RewriteRule composer\.(json|lock)$ - [F,L]
    RewriteRule package\.json$ - [F,L]
    RewriteRule package-lock\.json$ - [F,L]
    RewriteRule artisan$ - [F,L]
    RewriteRule phpunit\.xml$ - [F,L]

    # Deployment/diagnostic utilities can modify the database or filesystem;
    # they must never be callable from the public production website.
    RewriteRule ^(?:setup_backend|data_setup|test_system|create_storage_link|log_activity)\.php$ - [F,L,NC]

    # Blokir akses ke file hidden (dimulai dengan titik)
    RewriteRule ^\. - [F,L]

    # Block sensitive Laravel directories.
    RewriteRule ^(app|bootstrap|config|database|routes|storage|vendor|tests)/ - [F,L]

    # Serve existing React build assets and public files as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React SPA fallback.
    RewriteRule ^ index.html [L]
</IfModule>

# Mencegah listing directory (Di-comment agar tidak 500 di Plesk/cPanel tertentu)
# Options -Indexes
